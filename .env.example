# ArkFlow — environment variables
#
# Copy to `.env.local` for local development, and set the same names in
# Vercel for Preview and Production. This file is committed; it carries
# NAMES AND SHAPES ONLY. Never paste a real token, ID or URL into it.
#
# Every variable the codebase reads is listed here. Nothing else is read.


# ─── Analytics ────────────────────────────────────────────────────────
# Google Analytics 4 measurement ID (starts with G-).
# Read by components/analytics/google-analytics.tsx, which renders
# nothing when this is unset — so leaving it blank locally is correct
# and safe.
#
# Set only for Production in Vercel; leave unset or use a separate
# property for Preview, so branch and PR traffic never lands in the
# real property.
NEXT_PUBLIC_GA_ID=


# ─── Canonical origin ─────────────────────────────────────────────────
# Overrides the production origin used for canonical URLs, OG tags, the
# sitemap and JSON-LD. Read by lib/site.ts.
#
# Leave UNSET in Production — the code falls back to
# https://www.arkflowsolutions.com, which is the verified canonical
# origin. Setting it wrongly makes every page declare the wrong
# canonical, which is the exact failure lib/site.ts documents.
#
# No trailing slash (one is stripped if present).
NEXT_PUBLIC_SITE_URL=


# ─── Enquiry delivery (app/api/enquiry) ───────────────────────────────
# The /api/enquiry route delivers website enquiries into GoHighLevel and
# tries three paths in order. See app/api/enquiry/route.ts.
#
# IMPORTANT: with none of these set the route still returns success and
# only logs the enquiry. The form appears to work and no contact is
# created. Configure path 1 or path 2 before promoting the site.

# Path 1 — GoHighLevel Contacts API (recommended).
# BOTH must be set for this path to be used.
# GHL_API_TOKEN is a Private Integration token with the contacts.write
# scope. It is a SECRET: server-side only, never prefixed NEXT_PUBLIC_.
GHL_API_TOKEN=
GHL_LOCATION_ID=

# Path 2 — Inbound webhook fallback, used only when path 1 is unset.
# A GoHighLevel Inbound Webhook URL.
GHL_WEBHOOK_URL=

# Optional — override the endpoint the contact form posts to.
# Read by components/contact/contact-experience.tsx; defaults to
# /api/enquiry when unset. Only needed to point the form at an external
# collector instead of this app's own route.
NEXT_PUBLIC_ENQUIRY_ENDPOINT=
